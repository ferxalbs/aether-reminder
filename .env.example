# Public development Cloud URL. This is not a secret.
# For USB reverse to a local Cloud process:
# EXPO_PUBLIC_AETHER_CLOUD_URL=http://127.0.0.1:8080
EXPO_PUBLIC_AETHER_CLOUD_URL=

# Optional development identity overrides. These are test labels, not credentials.
EXPO_PUBLIC_AETHER_DEV_USER_ID=e2e.mobile.physical.aether-reminder
EXPO_PUBLIC_AETHER_DEV_DEVICE_ID=e2e.device.physical.dev
